NEXT_PUBLIC_SITE_URL=https://your-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="AeroCareer Hub <no-reply@your-domain.example>"
MAIL_TO=your-inbox@example.com
# Admin panel at /admin. It stays locked until all three are set.
# Password: at least 12 characters. Secret: at least 32 characters, for example from "openssl rand -hex 32".
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=
# MongoDB holds saved jobs, settings and logos. Without it the site shows the samples and the admin panel cannot save.
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional database name. Defaults to aerocareer.
MONGODB_DB=aerocareer
